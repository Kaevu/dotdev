---
import FluidOrb from "./FluidOrb.tsx";
import MoreMenu from "./MoreMenu.astro";
const path = Astro.url.pathname;
---
<header class="mb-12">
  <a href="/" class="inline-flex items-center gap-2.5 mb-5 text-neutral-100" aria-label="Kaevu home">
    <FluidOrb client:visible size={40} color="#115e59" aria-hidden="true" class="shrink-0" />
    <span class="text-3xl font-light tracking-tight font-serif">Kaevu</span>
  </a>

  <nav class="flex gap-6 text-sm flex-wrap items-start" aria-label="Primary">
    <a href="/" aria-current={path === "/" ? "page" : undefined} class={path === "/" ? "text-neutral-100 font-medium" : "text-neutral-500 hover:text-neutral-300"}>Home</a>
    <a href="/projects" aria-current={path === "/projects" ? "page" : undefined} class={path === "/projects" ? "text-neutral-100 font-medium" : "text-neutral-500 hover:text-neutral-300"}>Projects</a>
    <a href="/baseball" aria-current={path === "/baseball" ? "page" : undefined} class={path === "/baseball" ? "text-neutral-100 font-medium" : "text-neutral-500 hover:text-neutral-300"}>Baseball</a>
    <a href="/bookmarks" aria-current={path.startsWith("/bookmarks") ? "page" : undefined} class={path.startsWith("/bookmarks") ? "text-neutral-100 font-medium" : "text-neutral-500 hover:text-neutral-300"}>Bookmarks</a>

    <MoreMenu />
  </nav>
</header>

