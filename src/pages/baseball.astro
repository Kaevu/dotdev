---
import BaseLayout from "../layouts/BaseLayout.astro"
import BaseballTable from "../components/BaseballTable.tsx";
---

<BaseLayout>
  <main class="mx-auto py-8 px-4 max-w-7xl">
    <h1 class="text-3xl font-semibold mb-2">Baseball</h1>
    <p class="text-neutral-400 mb-6">Rolling-window form for the Yankees and the farm — who's breaking out, who's slumping.</p>
    <BaseballTable client:load />
  </main>
</BaseLayout>
