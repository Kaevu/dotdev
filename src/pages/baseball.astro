---
import BaseLayout from "../layouts/BaseLayout.astro"
import BaseballTable from "../components/BaseballTable.tsx";
---

<BaseLayout title="Ball Knowledge — Kaevu" description="Who's breaking out and who's slumping in the Yankees organization.">
  <main class="mx-auto py-8 px-4 max-w-[88rem]">
    <h1 class="text-3xl font-semibold mb-2 font-serif">Ball Knowledge</h1>
    <p class="text-neutral-400 mb-6">Who's breaking out, who's slumping across the Yankees organization.</p>
    <BaseballTable client:visible />
  </main>
</BaseLayout>
