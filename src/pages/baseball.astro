---
import BaseLayout from "../layouts/BaseLayout.astro"
import BaseballTable from "../components/BaseballTable.tsx";
---

<BaseLayout title="Ball Knowledge — Kaevu" description="Who's breaking out and who's slumping in the Yankees organization.">
  <main class="mx-auto py-8 px-4 max-w-[88rem]">
    <h1 class="text-3xl font-semibold mb-2 font-sans">Ball Knowledge</h1>
    <p class="text-neutral-400 mb-1">Rolling form windows across the Yankees organization — Bronx plus affiliates.</p>
    <p class="text-neutral-500 text-sm mb-6">Deltas compare each window against the one before it — green is improving, red is slipping.</p>
    <BaseballTable client:visible />
  </main>
</BaseLayout>
