---
import BaseLayout from "../layouts/BaseLayout.astro"

type Project = {
  title: string;
  description: string;
  stack: string[];
  url?: string;
  image?: string;
  tint: [string, string];
};

const projects: Project[] = [
  {
    title: "Pitch Sequencing & Prediction",
    description:
      "Analyze how pitchers sequence pitches across counts, handedness, and game context, feeding those patterns into a real-time pitch prediction service.",
    stack: ["Rust", "OCaml", "PostgreSQL", "Parquet", "WebSockets", "MLB Stats API"],
    tint: ["#1a2e22", "#101613"],
  },
  {
    title: "Baseball Game Prediction",
    description:
      "Predictive models for MLB game outcomes from historical game and player data.",
    stack: ["Python", "pandas", "scikit-learn", "MLB Stats API"],
    tint: ["#2e2a1a", "#141310"],
  },
  {
    title: "Homelab Infrastructure",
    description:
      "Self-hosted environment for experimenting with virtualization, containers, networking, Kubernetes, and infrastructure automation.",
    stack: ["Proxmox", "Docker", "k3s", "Terraform", "Tailscale", "Traefik", "Cloudflare"],
    tint: ["#1b2433", "#10131a"],
  },
  {
    title: "Discord Bot",
    description:
      "Containerized Discord bot serving World of Warcraft info via the Blizzard API, with SQLite for persistent data.",
    stack: ["TypeScript", "Node.js", "Docker", "SQLite", "Blizzard API", "Discord API"],
    tint: ["#232338", "#14141c"],
  },
  {
    title: "Personal Website",
    description:
      "This site — a portfolio and knowledge space on Astro, with Cloudflare on the edge and D1 for persistent data.",
    stack: ["Astro", "TypeScript", "Tailwind CSS", "Cloudflare Workers", "Cloudflare D1", "SQLite"],
    tint: ["#2a2126", "#151214"],
  },
];

const cardClass =
  "flex gap-4 p-4 bg-neutral-900 rounded border border-neutral-800 transition-colors";
const linkClass = " hover:border-neutral-600";
---

<BaseLayout title="Projects — Kaevu" description="Things Kaevu is building: baseball analytics, homelab infrastructure, and tooling.">
  <main class="mx-auto py-8 px-4 max-w-3xl">
    <h1 class="text-3xl font-semibold mb-2 font-sans">Projects</h1>
    <p class="text-neutral-400 mb-8">Things I'm building and tinkering with.</p>

    <div class="space-y-3">
      {projects.map((p) => {
        const inner = (
          <>
            <span
              class="w-24 sm:w-32 shrink-0 self-start aspect-square rounded-lg border border-neutral-800 overflow-hidden"
              style={`background: linear-gradient(135deg, ${p.tint[0]}, ${p.tint[1]})`}
            >
              {p.image && (
                <img src={p.image} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover" />
              )}
            </span>
            <span class="flex flex-col min-w-0">
              <span class="font-sans text-base text-neutral-100 mb-1">{p.title}</span>
              <span class="text-sm text-neutral-400 leading-relaxed line-clamp-3">{p.description}</span>
              <span class="flex flex-wrap gap-1.5 mt-2.5">
                {p.stack.map((s) => (
                  <span class="pill pill-other">{s}</span>
                ))}
              </span>
            </span>
          </>
        );
        return p.url ? (
          <a href={p.url} target="_blank" rel="noreferrer noopener" class={cardClass + linkClass}>{inner}</a>
        ) : (
          <article class={cardClass}>{inner}</article>
        );
      })}
    </div>
  </main>
</BaseLayout>
