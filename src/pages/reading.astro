---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro"
import Bookshelf from "../components/Bookshelf.tsx";

type ShareItem = {
  name: string;
  size: number;
  last_modified?: string;
  mode?: number | string;
};

const SHARE_ID = "Xio8EZcNj5vpmpMgbtMK7F";
const RES_URL = `https://ebooks.kaevu.dev/api/v2/shares/${SHARE_ID}/dirs`;

let items: ShareItem[] = [];
let shelfOk = false;
try {
  const res = await fetch(RES_URL, {
    headers: { accept: "application/json" },
    signal: AbortSignal.timeout(8000),
  });
  if (res.ok) {
    items = (await res.json()) as ShareItem[];
    shelfOk = true;
  } else {
    console.error("Reading: fetch failed", res.status);
  }
} catch (e) {
  console.error("Reading: fetch error", e);
}

const VALID_TAGS = new Set(["cs", "ml", "finance", "math", "other"]);

function loadTagMap(): Record<string, string[]> {
  const filePath = join(process.cwd(), "src", "data", "books", "tags.md");
  let text: string;
  try {
    text = readFileSync(filePath, "utf-8");
  } catch {
    return {};
  }
  const map: Record<string, string[]> = {};
  for (const raw of text.split("\n")) {
    const line = raw.trim();
    if (
      !line ||
      line.startsWith("#") ||
      line.startsWith("---") ||
      line.startsWith("```")
    ) {
      continue;
    }
    const sep = line.indexOf("|");
    if (sep === -1) continue;
    const key = line.slice(0, sep).trim().toLowerCase();
    if (!key || key === "clean book title") continue;
    const tags = line
      .slice(sep + 1)
      .split(",")
      .map((t) => t.trim().toLowerCase())
      .filter((t) => VALID_TAGS.has(t));
    if (tags.length) map[key] = tags;
  }
  return map;
}

const tags = loadTagMap();
---

<BaseLayout title="Reading — Kaevu" description="Bookshelf: searchable notes across CS, ML, finance, and math.">
  <div class="mt-8">
    <h1 id="bookshelf-heading" class="text-xl font-light tracking-tight mb-2 font-sans">Reading</h1>
    <p class="text-sm text-neutral-500 mb-6">Textbooks I've made easily accessible for myself — tracking what I have and what I've read.</p>
    {!shelfOk && (
      <p class="text-sm text-neutral-500 mb-6">The shelf failed to load during the last build — the list below may be incomplete.</p>
    )}
    <Bookshelf client:visible items={items} tags={tags} />
  </div>
</BaseLayout>
