---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import RecentPosts from "../components/RecentPosts.astro";
import RecentGames from "../components/RecentGames.astro";
import RecentBookmarks from "../components/RecentBookmarks.astro";
import { getCollection } from 'astro:content';

const hasPosts = (await getCollection('blog', ({ data }) => !data.draft)).length > 0;
---

<BaseLayout>
  <div class="space-y-9">
    <div class="border-l-2 border-neutral-700 pl-4 py-1">
      <p class="text-neutral-400 italic text-sm">
        "A man's reach should exceed his grasp, or what's a heaven for?"
      </p>
    </div>

    <div>
      <p class="text-neutral-300 text-sm leading-relaxed">
        Notes and thoughts from a CS grad with interests in infrastructure, GPUs,
        and scrolling FanGraphs way too much.
      </p>
    </div>

    {hasPosts && (
      <section aria-labelledby="writing-heading">
        <h2 id="writing-heading" class="text-xl font-light tracking-tight mb-4 font-serif">Writing</h2>
        <RecentPosts />
      </section>
    )}

    <section aria-labelledby="games-heading">
      <h2 id="games-heading" class="text-xl font-light tracking-tight mb-4 font-serif">Recent games</h2>
      <RecentGames />
    </section>

    <section aria-labelledby="bookmarks-heading">
      <h2 id="bookmarks-heading" class="text-xl font-light tracking-tight mb-4 font-serif">Recent bookmarks</h2>
      <RecentBookmarks />
      <div class="mt-4">
        <a href="/bookmarks" class="text-sm text-neutral-400 hover:text-neutral-200 transition-colors underline underline-offset-4">View all bookmarks →</a>
      </div>
    </section>
  </div>
</BaseLayout>
