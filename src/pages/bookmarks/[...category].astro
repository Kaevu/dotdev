---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Bookmarks from "../../components/Bookmarks.tsx";
import { checkTag } from "../../lib/bookmarks/taxonomy";
import { subtreeFilter } from "../../lib/bookmarks/view";
import { fetchBookmarks } from "../../lib/bookmarks/store";

let category: string | null = null;
let items = [];
const raw = Astro.params.category ?? "";
const check = checkTag(decodeURIComponent(raw));
if (check.ok) {
  category = check.tag;
  const all = await fetchBookmarks(Astro.locals);
  items = subtreeFilter(all, category);
} else {
  return Astro.redirect("/bookmarks");
}
---

<BaseLayout title={category ? `Bookmarks: ${category} — Kaevu` : "Bookmarks — Kaevu"} description={category ? `Saved links tagged ${category}.` : "Saved links."}>
  <div class="mt-8">
    <h1 id="bookmarks-category-heading" class="text-xl font-light tracking-tight mb-2 font-sans">Bookmarks: {category}</h1>
    <p class="text-sm text-neutral-500 mb-6">
      <a href="/bookmarks" class="underline underline-offset-4 hover:text-neutral-300">All bookmarks</a> · shelf {category}
    </p>
    <Bookmarks client:visible items={items} category={category} />
  </div>
</BaseLayout>
